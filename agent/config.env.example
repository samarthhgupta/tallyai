# TallyAI Agent Configuration
# Copy this file to config.env and fill in your values

# Your unique agent token (get this from TallyAI dashboard)
AGENT_TOKEN=paste_your_token_here

# TallyAI cloud URL (do not change)
CLOUD_URL=wss://api.tallyai.in/agent/connect

# Tally XML API URL (do not change unless Tally is on a different port)
TALLY_URL=http://localhost:9000
